* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    background:
        radial-gradient(circle at top, #25304a, #101522 45%, #080b12);
    color: white;
    font-family: Arial, sans-serif;
}

.game {
    width: 100%;
    max-width: 560px;
    min-height: 100vh;
    margin: auto;
    padding: 16px;
}

.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
}

.top-bar h1 {
    font-size: 26px;
}

.top-bar span {
    color: #aeb8cc;
    font-size: 13px;
}

.money-box {
    background: rgba(255,255,255,.08);
    padding: 11px 14px;
    border-radius: 14px;
    font-weight: bold;
}

.company-card {
    text-align: center;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 24px;
    padding: 22px 15px;
}

.company-icon {
    font-size: 65px;
}

.company-card h2 {
    margin: 8px 0;
}

.company-card p {
    color: #aeb8cc;
    margin-bottom: 20px;
}

.tap-button {
    width: 190px;
    height: 190px;
    border: 0;
    border-radius: 50%;
    background:
        radial-gradient(circle, #ffd95a, #f3ad20 55%, #c76b0c);
    color: #17120a;
    font-size: 24px;
    font-weight: bold;
    cursor: pointer;
    box-shadow: 0 15px 35px rgba(0,0,0,.4);
}

.tap-button:active {
    transform: scale(.94);
}

.tap-button span {
    display: block;
    margin-top: 8px;
    color: #17120a;
}

.income {
    margin-top: 18px;
    color: #aeb8cc;
}

.income strong,
.green {
    color: #72e6a4;
}

.red {
    color: #ff6868;
}

.stats {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 10px;
    margin: 15px 0;
}

.stat {
    text-align: center;
    padding: 13px 5px;
    background: rgba(255,255,255,.06);
    border-radius: 15px;
}

.stat span {
    font-size: 20px;
}

.stat small {
    display: block;
    color: #9ca8bd;
    font-size: 11px;
    margin: 4px 0;
}

.menu {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 10px;
    margin-bottom: 20px;
}

.menu-button {
    min-height: 72px;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 16px;
    background: rgba(255,255,255,.06);
    color: white;
    font-size: 22px;
}

.menu-button span {
    display: block;
    color: #c5cede;
    font-size: 12px;
    margin-top: 5px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

.upgrade-card,
.office-card,
.secretary,
.company,
.contract,
.card,
.field-card,
.profit-card,
.resources,
.chart {
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 17px;
    padding: 15px;
    margin-bottom: 10px;
}

.upgrade-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
}

.upgrade-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.upgrade-info span,
.secretary p,
.company p {
    color: #9ca8bd;
    font-size: 13px;
}

.upgrade-button {
    border: 0;
    border-radius: 11px;
    padding: 11px 14px;
    background: #4e8cff;
    color: white;
    font-weight: bold;
}

.accept-button {
    width: 100%;
    padding: 12px;
    border: 0;
    border-radius: 10px;
    background: #20a85a;
    color: white;
    font-weight: bold;
    margin-top: 15px;
}

.reject-button {
    width: 100%;
    padding: 12px;
    border: 0;
    border-radius: 10px;
    background: #8d3030;
    color: white;
    font-weight: bold;
    margin-top: 8px;
}

.categories {
    display: flex;
    gap: 8px;
    margin: 12px 0;
}

.categories button {
    flex: 1;
    padding: 11px;
    border: 0;
    border-radius: 10px;
    background: #292f39;
    color: white;
}

.products {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 10px;
}

.card .image {
    height: 100px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #11151b;
    border-radius: 12px;
    font-size: 50px;
    margin-bottom: 10px;
}

.price,
.wealth {
    color: #42e695;
    font-weight: bold;
    margin: 8px 0;
}

.buy {
    width: 100%;
    padding: 10px;
    border: 0;
    border-radius: 9px;
    background: #2563eb;
    color: white;
}

.notice,
.map-label {
    background: #202733;
    padding: 10px;
    border-radius: 10px;
    margin-bottom: 12px;
}

.map {
    height: 430px;
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    background: #164b72;
    transition: transform .3s;
    transform-origin: center;
}

.sea {
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at 80% 20%, #236a8c, transparent 25%),
        radial-gradient(circle at 20% 70%, #0d4569, transparent 30%);
}

.land {
    position: absolute;
    background: #277a43;
    border: 3px solid #1c5d34;
    border-radius: 45%;
}

.land1 {
    width: 330px;
    height: 230px;
    top: 70px;
    right: 90px;
    transform: rotate(-12deg);
}

.land2 {
    width: 180px;
    height: 130px;
    bottom: 10px;
    left: 20px;
    transform: rotate(15deg);
}

.land3 {
    width: 130px;
    height: 90px;
    top: 20px;
    left: 20px;
}

.road {
    position: absolute;
    background: #555b5c;
    z-index: 2;
}

.road1 {
    width: 100%;
    height: 40px;
    top: 200px;
}

.road2 {
    width: 40px;
    height: 100%;
    right: 220px;
}

.building {
    position: absolute;
    width: 58px;
    height: 58px;
    background: #687381;
    border: 2px solid #111;
    border-radius: 7px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 27px;
    z-index: 4;
}

.b1 { top: 60px; right: 55px; }
.b2 { top: 100px; left: 70px; }
.b3 { top: 275px; right: 80px; }
.b4 { top: 285px; left: 60px; }
.b5 { top: 120px; right: 280px; }

.smoke {
    position: absolute;
    font-size: 28px;
    animation: smoke 3s infinite;
    z-index: 5;
}

.s1 { top: 50px; left: 80px; }
.s2 { top: 70px; right: 290px; }
.s3 { top: 235px; right: 90px; }

@keyframes smoke {
    0% {
        transform: translateY(15px);
        opacity: .8;
    }

    100% {
        transform: translateY(-45px);
        opacity: 0;
    }
}

.map-label {
    position: absolute;
    top: 15px;
    right: 15px;
    z-index: 10;
}

.zoom-controls {
    position: absolute;
    left: 15px;
    top: 15px;
    z-index: 20;
}

.zoom-controls button {
    display: block;
    width: 42px;
    height: 42px;
    margin-bottom: 5px;
    border: 0;
    border-radius: 9px;
    background: rgba(0,0,0,.65);
    color: white;
    font-size: 25px;
}

.risk {
    color: #ff6363;
}

input,
textarea {
    width: 100%;
    background: #0f1216;
    color: white;
    border: 1px solid #444;
    border-radius: 10px;
    padding: 11px;
    margin: 10px 0;
}

.secretary-chat {
    margin-top: 18px;
    background: #11151b;
    padding: 12px;
    border-radius: 12px;
}

.secretary-chat input {
    margin-bottom: 5px;
}

.secretary-message {
    background: #202733;
    padding: 10px;
    border-radius: 10px;
    margin-bottom: 8px;
    line-height: 1.6;
}

.field-option {
    padding: 16px;
    margin: 10px 0;
    border-radius: 15px;
    background: #202733;
    border: 1px solid #394354;
}

.field-option h3 {
    margin-bottom: 7px;
}

.field-option p {
    color: #aeb8cc;
    font-size: 13px;
    margin-bottom: 10px;
}

.chart {
    text-align: center;
    overflow: hidden;
}

.arrow.up {
    font-size: 75px;
    color: #48df87;
}

.chart-line {
    font-size: 35px;
    letter-spacing: 5px;
    color: #55db91;
    margin: 5px 0 10px;
}

.resource-row {
    display: flex;
    justify-content: space-between;
    padding: 12px;
    background: #11151b;
    border-radius: 10px;
    margin: 7px 0;
}

.contract h3 {
    margin-bottom: 15px;
}

.contract-text {
    line-height: 1.8;
    background: #11151b;
    padding: 15px;
    border-radius: 12px;
}

.owned-building {
    position: absolute;
    width: 55px;
    height: 55px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #d7a647;
    border: 3px solid #fff;
    border-radius: 9px;
    font-size: 28px;
    z-index: 8;
}

@media(max-width:380px) {

    .tap-button {
        width: 165px;
        height: 165px;
    }

    .products {
        grid-template-columns: 1fr;
    }
}
